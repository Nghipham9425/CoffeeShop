generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTANT
  CUSTOMER
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
  VNPAY
  ZALOPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  WAITING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum DebtStatus {
  OPEN
  PARTIAL
  CLEARED
  OVERDUE
}

enum ChatbotSender {
  CUSTOMER
  BOT
  STAFF
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
}

enum StockMovementType {
  IMPORT
  EXPORT
  ADJUSTMENT
  RETURN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model User {
  id                   Int                   @id @default(autoincrement())
  fullName             String                @map("full_name")
  email                String                @unique
  passwordHash         String                @map("password_hash")
  phone                String?
  role                 UserRole              @default(CUSTOMER)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  addresses            Address[]
  orders               Order[]
  chatbotConversations ChatbotConversation[]
  cart                 Cart?
  reviews              Review[]
  loyaltyProfile       LoyaltyProfile?
  aiRecommendations    AiRecommendation[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id             Int      @id @default(autoincrement())
  categoryId     Int      @map("category_id")
  name           String
  slug           String   @unique
  description    String?
  unit           String   @default("kg")
  price          Decimal? @db.Decimal(12, 2)
  minimumOrderKg Int      @default(5) @map("minimum_order_kg")
  imageUrl       String?  @map("image_url")
  isRetail       Boolean  @default(true) @map("is_retail")
  isB2b          Boolean  @default(true) @map("is_b2b")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  category       Category @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  reviews        Review[]
  priceHistories ProductPriceHistory[]
  promotionItems PromotionProduct[]
  purchaseItems  PurchaseOrderItem[]
  aiRecommendations AiRecommendation[]

  @@map("products")
}

model QuoteRequest {
  id                 Int                @id @default(autoincrement())
  companyName        String             @map("company_name")
  contactName        String             @map("contact_name")
  phoneOrEmail       String             @map("phone_or_email")
  productNeed        String             @map("product_need")
  expectedQuantityKg Int?               @map("expected_quantity_kg")
  note               String?
  status             QuoteRequestStatus @default(NEW)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  businessCustomerId Int?               @map("business_customer_id")
  businessCustomer   BusinessCustomer?  @relation(fields: [businessCustomerId], references: [id])

  @@map("quote_requests")
}

model Address {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  receiverName String  @map("receiver_name")
  phone       String
  province    String
  district    String
  ward        String
  detail      String
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id])
  orders      Order[]

  @@map("addresses")
}

model Order {
  id                Int           @id @default(autoincrement())
  userId            Int?          @map("user_id")
  addressId         Int?          @map("address_id")
  orderCode         String        @unique @map("order_code")
  customerName      String        @map("customer_name")
  customerPhone     String        @map("customer_phone")
  customerEmail     String?       @map("customer_email")
  subtotal          Decimal       @default(0) @db.Decimal(12, 2)
  shippingFee       Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount       Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  note              String?
  status            OrderStatus   @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User?         @relation(fields: [userId], references: [id])
  address           Address?      @relation(fields: [addressId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  shipment          Shipment?
  cancellation      OrderCancellation?
  reviews           Review[]
  refunds           Refund[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int           @map("order_id")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  transactionCode String?       @map("transaction_code")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  order           Order         @relation(fields: [orderId], references: [id])
  refunds         Refund[]

  @@map("payments")
}

model Shipment {
  id             Int            @id @default(autoincrement())
  orderId         Int           @unique @map("order_id")
  carrier        String?
  trackingCode   String?        @map("tracking_code")
  status         ShipmentStatus @default(WAITING)
  shippedAt      DateTime?      @map("shipped_at")
  deliveredAt    DateTime?      @map("delivered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  order          Order          @relation(fields: [orderId], references: [id])
  deliveryLogs   DeliveryLog[]

  @@map("shipments")
}

model OrderCancellation {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique @map("order_id")
  reason      String
  cancelledBy String   @map("cancelled_by")
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id])

  @@map("order_cancellations")
}

model Refund {
  id        Int          @id @default(autoincrement())
  orderId   Int          @map("order_id")
  paymentId Int?         @map("payment_id")
  amount    Decimal      @db.Decimal(12, 2)
  reason    String?
  status    RefundStatus @default(REQUESTED)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  order     Order        @relation(fields: [orderId], references: [id])
  payment   Payment?     @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model DeliveryLog {
  id         Int      @id @default(autoincrement())
  shipmentId Int     @map("shipment_id")
  status     String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  @@map("delivery_logs")
}

model BusinessCustomer {
  id            Int            @id @default(autoincrement())
  companyName   String         @map("company_name")
  taxCode       String?        @unique @map("tax_code")
  contactName   String         @map("contact_name")
  phone         String
  email         String?
  address       String?
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  quoteRequests QuoteRequest[]
  contracts     Contract[]
  invoices      Invoice[]
  debts         Debt[]

  @@map("business_customers")
}

model Contract {
  id                 Int              @id @default(autoincrement())
  businessCustomerId Int              @map("business_customer_id")
  contractCode       String           @unique @map("contract_code")
  title              String
  startDate          DateTime?        @map("start_date")
  endDate            DateTime?        @map("end_date")
  totalValue         Decimal?         @map("total_value") @db.Decimal(14, 2)
  depositPercent     Int              @default(30) @map("deposit_percent")
  status             ContractStatus   @default(DRAFT)
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  businessCustomer   BusinessCustomer @relation(fields: [businessCustomerId], references: [id])
  invoices           Invoice[]

  @@map("contracts")
}

model Invoice {
  id                 Int              @id @default(autoincrement())
  businessCustomerId Int              @map("business_customer_id")
  contractId         Int?             @map("contract_id")
  invoiceCode        String           @unique @map("invoice_code")
  amount             Decimal          @db.Decimal(14, 2)
  paidAmount         Decimal          @default(0) @map("paid_amount") @db.Decimal(14, 2)
  dueDate            DateTime?        @map("due_date")
  status             InvoiceStatus    @default(UNPAID)
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  businessCustomer   BusinessCustomer @relation(fields: [businessCustomerId], references: [id])
  contract           Contract?        @relation(fields: [contractId], references: [id])
  debts              Debt[]

  @@map("invoices")
}

model Debt {
  id                 Int              @id @default(autoincrement())
  businessCustomerId Int              @map("business_customer_id")
  invoiceId          Int?             @map("invoice_id")
  debtCode           String           @unique @map("debt_code")
  originalAmount     Decimal          @map("original_amount") @db.Decimal(14, 2)
  remainingAmount    Decimal          @map("remaining_amount") @db.Decimal(14, 2)
  dueDate            DateTime?        @map("due_date")
  status             DebtStatus       @default(OPEN)
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  businessCustomer   BusinessCustomer @relation(fields: [businessCustomerId], references: [id])
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id])

  @@map("debts")
}

model Inventory {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  quantity     Int      @default(0)
  minQuantity  Int      @default(0) @map("min_quantity")
  warehouse    String   @default("Kho chinh")
  updatedAt    DateTime @updatedAt @map("updated_at")
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([productId, warehouse])
  @@map("inventories")
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  type      StockMovementType
  quantity  Int
  reason    String?
  reference String?
  createdAt DateTime          @default(now()) @map("created_at")
  product   Product           @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model ProductPriceHistory {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  oldPrice    Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  reason      String?
  appliedAt   DateTime @default(now()) @map("applied_at")
  product     Product  @relation(fields: [productId], references: [id])

  @@map("product_price_histories")
}

model Promotion {
  id              Int                @id @default(autoincrement())
  name            String
  code            String?            @unique
  discountType    DiscountType       @map("discount_type")
  discountValue   Decimal            @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount  Decimal?           @map("min_order_amount") @db.Decimal(12, 2)
  startAt         DateTime           @map("start_at")
  endAt           DateTime           @map("end_at")
  status          PromotionStatus    @default(DRAFT)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  products        PromotionProduct[]

  @@map("promotions")
}

model PromotionProduct {
  id          Int       @id @default(autoincrement())
  promotionId Int      @map("promotion_id")
  productId   Int      @map("product_id")
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
  @@map("promotion_products")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Review {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  productId Int          @map("product_id")
  orderId   Int?         @map("order_id")
  rating    Int
  content   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  order     Order?       @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, orderId])
  @@map("reviews")
}

model LoyaltyProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  tier        String   @default("REGULAR")
  points      Int      @default(0)
  totalSpent  Decimal  @default(0) @map("total_spent") @db.Decimal(14, 2)
  orderCount  Int      @default(0) @map("order_count")
  lastPurchaseAt DateTime? @map("last_purchase_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("loyalty_profiles")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  phone          String?
  email          String?
  address        String?
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  supplierId    Int                 @map("supplier_id")
  purchaseCode  String              @unique @map("purchase_code")
  expectedDate  DateTime?           @map("expected_date")
  totalAmount   Decimal             @default(0) @map("total_amount") @db.Decimal(14, 2)
  status        PurchaseOrderStatus @default(DRAFT)
  note          String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  items         PurchaseOrderItem[]
  receipts      GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int           @map("purchase_order_id")
  productId        Int          @map("product_id")
  quantity         Int
  unitCost         Decimal      @map("unit_cost") @db.Decimal(12, 2)
  lineTotal        Decimal      @map("line_total") @db.Decimal(14, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product          Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              Int                @id @default(autoincrement())
  purchaseOrderId Int                @map("purchase_order_id")
  receiptCode     String             @unique @map("receipt_code")
  status          GoodsReceiptStatus @default(DRAFT)
  receivedAt      DateTime?          @map("received_at")
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at")
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])

  @@map("goods_receipts")
}

model AiRecommendation {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  productId   Int?     @map("product_id")
  sessionId   String?  @map("session_id")
  prompt      String
  answer      String
  intent      String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])

  @@map("ai_recommendations")
}

model ChatbotConversation {
  id          Int              @id @default(autoincrement())
  userId      Int?             @map("user_id")
  guestName   String?          @map("guest_name")
  guestPhone  String?          @map("guest_phone")
  topic       String?
  isResolved  Boolean          @default(false) @map("is_resolved")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User?            @relation(fields: [userId], references: [id])
  messages    ChatbotMessage[]

  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             Int                 @id @default(autoincrement())
  conversationId Int                 @map("conversation_id")
  sender         ChatbotSender
  content        String
  intent         String?
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id])

  @@map("chatbot_messages")
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?  @map("cover_image")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @unique
  answer    String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faqs")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")
  email     String?
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
