generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES
  WAREHOUSE
  ACCOUNTANT
  CUSTOMER
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  SEPAY
  MOMO
  VNPAY
  ZALOPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  WAITING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum DebtStatus {
  OPEN
  PARTIAL
  CLEARED
  OVERDUE
}

enum ChatbotSender {
  CUSTOMER
  BOT
  STAFF
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
}

enum StockMovementType {
  IMPORT
  EXPORT
  ADJUSTMENT
  RETURN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProductPriceType {
  RETAIL
  WHOLESALE
  VIP
  B2B
}

model User {
  id                   Int                   @id @default(autoincrement())
  fullName             String                @map("full_name")
  email                String                @unique
  passwordHash         String                @map("password_hash")
  phone                String?
  role                 UserRole              @default(CUSTOMER)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  addresses            Address[]
  orders               Order[]
  reviews              Review[]
  loyaltyProfile       LoyaltyProfile?
  chatbotConversations ChatbotConversation[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  receiverName String   @map("receiver_name")
  phone        String
  province     String
  district     String
  ward         String
  detail       String
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id])
  orders       Order[]

  @@map("addresses")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id             Int                 @id @default(autoincrement())
  categoryId     Int                 @map("category_id")
  name           String
  slug           String              @unique
  description    String?
  unit           String              @default("kg")
  price          Decimal?            @db.Decimal(12, 2)
  minimumOrderKg Int                 @default(5) @map("minimum_order_kg")
  imageUrl       String?             @map("image_url")
  isRetail       Boolean             @default(true) @map("is_retail")
  isB2b          Boolean             @default(true) @map("is_b2b")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  category       Category            @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  reviews        Review[]
  purchaseItems  PurchaseOrderItem[]
  prices         ProductPrice[]

  @@map("products")
}

model ProductPrice {
  id          Int              @id @default(autoincrement())
  productId   Int              @map("product_id")
  priceType   ProductPriceType @map("price_type")
  minQuantity Int              @default(1) @map("min_quantity")
  price       Decimal          @db.Decimal(12, 2)
  startAt     DateTime?        @map("start_at")
  endAt       DateTime?        @map("end_at")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  product     Product          @relation(fields: [productId], references: [id])

  @@unique([productId, priceType, minQuantity])
  @@map("product_prices")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  quantity    Int      @default(0)
  minQuantity Int      @default(0) @map("min_quantity")
  warehouse   String   @default("Kho chinh")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId, warehouse])
  @@map("inventories")
}

model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  type      StockMovementType
  quantity  Int
  reason    String?
  reference String?
  createdAt DateTime          @default(now()) @map("created_at")
  product   Product           @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model Promotion {
  id             Int             @id @default(autoincrement())
  name           String
  code           String?         @unique
  discountType   DiscountType    @map("discount_type")
  discountValue  Decimal         @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount Decimal?        @map("min_order_amount") @db.Decimal(12, 2)
  startAt        DateTime        @map("start_at")
  endAt          DateTime        @map("end_at")
  status         PromotionStatus @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  orders         Order[]

  @@map("promotions")
}

model Order {
  id              Int          @id @default(autoincrement())
  userId          Int?         @map("user_id")
  addressId       Int?         @map("address_id")
  promotionId     Int?         @map("promotion_id")
  orderCode       String       @unique @map("order_code")
  customerName    String       @map("customer_name")
  customerPhone   String       @map("customer_phone")
  customerEmail   String?      @map("customer_email")
  subtotal        Decimal      @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal      @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount  Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal      @default(0) @map("total_amount") @db.Decimal(12, 2)
  note            String?
  cancelReason    String?      @map("cancel_reason")
  refundAmount    Decimal?     @map("refund_amount") @db.Decimal(12, 2)
  status          OrderStatus  @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User?        @relation(fields: [userId], references: [id])
  address         Address?     @relation(fields: [addressId], references: [id])
  promotion       Promotion?   @relation(fields: [promotionId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  shipment        Shipment?
  reviews         Review[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int           @map("order_id")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  transactionCode String?       @map("transaction_code")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  order           Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Shipment {
  id           Int            @id @default(autoincrement())
  orderId      Int            @unique @map("order_id")
  carrier      String?
  trackingCode String?        @map("tracking_code")
  status       ShipmentStatus @default(WAITING)
  note         String?
  shippedAt    DateTime?      @map("shipped_at")
  deliveredAt  DateTime?      @map("delivered_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  order        Order          @relation(fields: [orderId], references: [id])

  @@map("shipments")
}

model Review {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  productId Int          @map("product_id")
  orderId   Int?         @map("order_id")
  rating    Int
  content   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id])
  product   Product      @relation(fields: [productId], references: [id])
  order     Order?       @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, orderId])
  @@map("reviews")
}

model LoyaltyProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique @map("user_id")
  tier           String    @default("REGULAR")
  points         Int       @default(0)
  totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  orderCount     Int       @default(0) @map("order_count")
  lastPurchaseAt DateTime? @map("last_purchase_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id])

  @@map("loyalty_profiles")
}

model BusinessCustomer {
  id            Int            @id @default(autoincrement())
  companyName   String         @map("company_name")
  taxCode       String?        @unique @map("tax_code")
  contactName   String         @map("contact_name")
  phone         String
  email         String?
  address       String?
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  quoteRequests QuoteRequest[]
  contracts     Contract[]
  invoices      Invoice[]
  debts         Debt[]

  @@map("business_customers")
}

model QuoteRequest {
  id                 Int                @id @default(autoincrement())
  businessCustomerId Int?               @map("business_customer_id")
  companyName        String             @map("company_name")
  contactName        String             @map("contact_name")
  phoneOrEmail       String             @map("phone_or_email")
  productNeed        String             @map("product_need")
  expectedQuantityKg Int?               @map("expected_quantity_kg")
  note               String?
  status             QuoteRequestStatus @default(NEW)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  businessCustomer   BusinessCustomer?  @relation(fields: [businessCustomerId], references: [id])

  @@map("quote_requests")
}

model Contract {
  id                 Int              @id @default(autoincrement())
  businessCustomerId Int              @map("business_customer_id")
  contractCode       String           @unique @map("contract_code")
  title              String
  startDate          DateTime?        @map("start_date")
  endDate            DateTime?        @map("end_date")
  totalValue         Decimal?         @map("total_value") @db.Decimal(14, 2)
  depositPercent     Int              @default(30) @map("deposit_percent")
  status             ContractStatus   @default(DRAFT)
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  businessCustomer   BusinessCustomer @relation(fields: [businessCustomerId], references: [id])
  invoices           Invoice[]

  @@map("contracts")
}

model Invoice {
  id                 Int              @id @default(autoincrement())
  businessCustomerId Int              @map("business_customer_id")
  contractId         Int?             @map("contract_id")
  invoiceCode        String           @unique @map("invoice_code")
  amount             Decimal          @db.Decimal(14, 2)
  paidAmount         Decimal          @default(0) @map("paid_amount") @db.Decimal(14, 2)
  dueDate            DateTime?        @map("due_date")
  status             InvoiceStatus    @default(UNPAID)
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  businessCustomer   BusinessCustomer @relation(fields: [businessCustomerId], references: [id])
  contract           Contract?        @relation(fields: [contractId], references: [id])
  debts              Debt[]

  @@map("invoices")
}

model Debt {
  id                 Int              @id @default(autoincrement())
  businessCustomerId Int              @map("business_customer_id")
  invoiceId          Int?             @map("invoice_id")
  debtCode           String           @unique @map("debt_code")
  originalAmount     Decimal          @map("original_amount") @db.Decimal(14, 2)
  remainingAmount    Decimal          @map("remaining_amount") @db.Decimal(14, 2)
  dueDate            DateTime?        @map("due_date")
  status             DebtStatus       @default(OPEN)
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  businessCustomer   BusinessCustomer @relation(fields: [businessCustomerId], references: [id])
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id])

  @@map("debts")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  phone          String?
  email          String?
  address        String?
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  supplierId   Int                 @map("supplier_id")
  purchaseCode String              @unique @map("purchase_code")
  expectedDate DateTime?           @map("expected_date")
  receivedAt   DateTime?           @map("received_at")
  totalAmount  Decimal             @default(0) @map("total_amount") @db.Decimal(14, 2)
  status       PurchaseOrderStatus @default(DRAFT)
  note         String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int           @map("purchase_order_id")
  productId       Int           @map("product_id")
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(12, 2)
  lineTotal       Decimal       @map("line_total") @db.Decimal(14, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model ChatbotConversation {
  id          Int              @id @default(autoincrement())
  userId      Int?             @map("user_id")
  guestName   String?          @map("guest_name")
  guestPhone  String?          @map("guest_phone")
  topic       String?
  isResolved  Boolean          @default(false) @map("is_resolved")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  user        User?            @relation(fields: [userId], references: [id])
  messages    ChatbotMessage[]

  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             Int                 @id @default(autoincrement())
  conversationId Int                 @map("conversation_id")
  sender         ChatbotSender
  content        String
  intent         String?
  createdAt      DateTime            @default(now()) @map("created_at")
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id])

  @@map("chatbot_messages")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")
  email     String?
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
